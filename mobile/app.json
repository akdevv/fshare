{
  "expo": {
    "name": "fshare",
    "slug": "fshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.akdevv.fshare",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "fshare connects to your laptop and nearby phones on the local network to transfer files.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSBonjourServices": ["_fshare._tcp"]
      },
      "buildNumber": "10000"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.akdevv.fshare",
      "versionCode": 10000
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "fshare uses the camera to scan the QR code shown by your laptop."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["*/*"],
            "multipleShareMimeTypes": ["*/*"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F6F7F2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "./plugins/with-release-signing",
      "./plugins/with-scene-lifecycle"
    ]
  }
}
